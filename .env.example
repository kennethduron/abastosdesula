NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Firebase web app (safe public identifiers, required to enable Firebase UI)
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=
NEXT_PUBLIC_USE_FIREBASE_EMULATORS=false

# Firebase Admin (server-only; never prefix with NEXT_PUBLIC_)
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=

# Server-only access policy. Keep false outside the commercial presentation stage.
PRESENTATION_AUTO_ACCESS=false

# Demo seed credentials: configure only in a secure local/CI environment
DEMO_MERCHANT_EMAIL=
DEMO_MERCHANT_PASSWORD=
DEMO_MERCHANT_B_EMAIL=
DEMO_MERCHANT_B_PASSWORD=
DEMO_ADMIN_EMAIL=
DEMO_ADMIN_PASSWORD=
DEMO_SEED_CONFIRM=
