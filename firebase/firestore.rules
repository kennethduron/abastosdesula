rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function isActiveUser() {
      return signedIn() &&
        exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.active == true &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == request.auth.token.role;
    }

    function isMerchant() {
      return isActiveUser() && request.auth.token.role == 'merchant' &&
        request.auth.token.businessId is string;
    }

    function ownsBusiness(businessId) {
      return isMerchant() && request.auth.token.businessId == businessId;
    }

    function isInstitutionalAdmin() {
      return isActiveUser() && request.auth.token.role == 'institutional_admin';
    }

    function isPresentationViewer() {
      return isActiveUser() && request.auth.token.role == 'presentation_viewer';
    }

    function isMerchantApplicant() {
      return isActiveUser() && request.auth.token.role == 'merchant_applicant';
    }

    function isPublicDocument() {
      return resource.data.status == 'active' &&
        (!('published' in resource.data) || resource.data.published == true);
    }

    function isInstitutionalReader() {
      return isInstitutionalAdmin() || isPresentationViewer();
    }

    function isQuoteStatus(status) {
      return status in [
        'new',
        'in_review',
        'quoted',
        'confirmed',
        'preparing',
        'completed',
        'cancelled'
      ];
    }

    function isQuoteSource(source) {
      return source in [
        'platform',
        'whatsapp',
        'phone',
        'in_person',
        'other'
      ];
    }

    function validMerchantQuoteCreate(quoteId) {
      return ownsBusiness(request.resource.data.businessId) &&
        request.resource.data.id == quoteId &&
        request.resource.data.customerId is string &&
        request.resource.data.customerName is string &&
        request.resource.data.customerName.size() >= 2 &&
        request.resource.data.phone is string &&
        request.resource.data.items is list &&
        request.resource.data.items.size() > 0 &&
        request.resource.data.items.size() <= 50 &&
        isQuoteStatus(request.resource.data.status) &&
        isQuoteSource(request.resource.data.source) &&
        request.resource.data.history is list &&
        request.resource.data.internalNotes is list &&
        request.resource.data.followUps is list &&
        request.resource.data.activity is list;
    }

    match /businesses/{businessId} {
      allow read: if isPublicDocument() || isInstitutionalReader() || ownsBusiness(businessId);
      allow create, delete: if isInstitutionalAdmin();
      allow update: if isInstitutionalAdmin() ||
        (ownsBusiness(businessId) && request.resource.data.id == resource.data.id &&
          request.resource.data.status == resource.data.status &&
          request.resource.data.slug == resource.data.slug &&
          request.resource.data.diff(resource.data).affectedKeys().hasOnly([
            'name', 'description', 'categoryId', 'categoryIds', 'phone',
            'whatsapp', 'hours', 'stall', 'logo', 'coverImage', 'published',
            'updatedAt'
          ]));
    }

    match /merchants/{merchantId} {
      allow read: if isPublicDocument() || isInstitutionalReader() || ownsBusiness(resource.data.businessId);
      allow create: if isInstitutionalAdmin();
      allow update: if isInstitutionalAdmin() ||
        (ownsBusiness(resource.data.businessId) &&
          request.resource.data.businessId == resource.data.businessId &&
          request.resource.data.slug == resource.data.slug &&
          request.resource.data.diff(resource.data).affectedKeys().hasOnly([
            'displayName', 'description', 'categoryIds', 'featuredProductIds',
            'image', 'imageAlt', 'whatsappDemo', 'published', 'updatedAt'
          ]));
      allow delete: if isInstitutionalAdmin();
    }

    match /categories/{categoryId} {
      allow read: if resource.data.visible == true || isInstitutionalReader();
      allow write: if isInstitutionalAdmin();
    }

    match /products/{productId} {
      allow read: if isPublicDocument() || isInstitutionalReader() || ownsBusiness(resource.data.businessId);
      allow create: if ownsBusiness(request.resource.data.businessId) &&
        request.resource.data.id == productId &&
        request.resource.data.stock is int && request.resource.data.stock >= 0 &&
        request.resource.data.minimumStock is int && request.resource.data.minimumStock >= 0 &&
        request.resource.data.status in ['active', 'inactive'];
      allow update: if ownsBusiness(resource.data.businessId) &&
        request.resource.data.businessId == resource.data.businessId &&
        request.resource.data.id == resource.data.id &&
        request.resource.data.stock is int && request.resource.data.stock >= 0 &&
        request.resource.data.minimumStock is int && request.resource.data.minimumStock >= 0 &&
        request.resource.data.status in ['active', 'inactive'];
      allow delete: if ownsBusiness(resource.data.businessId);
    }

    match /inventoryMovements/{movementId} {
      allow read: if isInstitutionalReader() || ownsBusiness(resource.data.businessId);
      allow create: if ownsBusiness(request.resource.data.businessId) &&
        request.resource.data.id == movementId &&
        request.resource.data.productId is string &&
        request.resource.data.type in ['entry', 'exit', 'adjustment'] &&
        request.resource.data.quantity is int && request.resource.data.quantity >= 0 &&
        request.resource.data.previousStock is int && request.resource.data.previousStock >= 0 &&
        request.resource.data.newStock is int && request.resource.data.newStock >= 0 &&
        request.resource.data.createdBy == request.auth.uid &&
        get(/databases/$(database)/documents/products/$(request.resource.data.productId)).data.businessId == request.resource.data.businessId &&
        get(/databases/$(database)/documents/products/$(request.resource.data.productId)).data.stock == request.resource.data.previousStock &&
        getAfter(/databases/$(database)/documents/products/$(request.resource.data.productId)).data.stock == request.resource.data.newStock;
      allow update, delete: if false;
    }

    match /merchantApplications/{applicationId} {
      allow read: if isInstitutionalReader() ||
        (isMerchantApplicant() && resource.data.userId == request.auth.uid);
      allow write: if false;
    }

    match /quoteRequests/{quoteId} {
      allow read: if ownsBusiness(resource.data.businessId);
      allow create: if validMerchantQuoteCreate(quoteId);
      allow update: if ownsBusiness(resource.data.businessId) &&
        request.resource.data.businessId == resource.data.businessId &&
        request.resource.data.customerId == resource.data.customerId &&
        isQuoteStatus(request.resource.data.status) &&
        request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly([
            'status',
            'history',
            'quotation',
            'internalNotes',
            'followUps',
            'activity',
            'updatedAt'
          ]);
      allow delete: if false;
    }

    match /customers/{customerId} {
      allow read, delete: if ownsBusiness(resource.data.businessId);
      allow create: if ownsBusiness(request.resource.data.businessId) &&
        request.resource.data.id == customerId &&
        request.resource.data.name is string &&
        request.resource.data.phone is string;
      allow update: if ownsBusiness(resource.data.businessId) &&
        request.resource.data.businessId == resource.data.businessId &&
        request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(['internalNotes', 'updatedAt']);
    }

    match /activities/{activityId} {
      allow read: if isInstitutionalReader() || ownsBusiness(resource.data.businessId);
      allow write: if false;
    }

    match /tenantAccounts/{businessId} {
      allow read: if isInstitutionalReader() ||
        (ownsBusiness(businessId) && resource.data.businessId == businessId);
      allow write: if false;
    }

    match /tenantPayments/{paymentId} {
      allow read: if isInstitutionalReader() || ownsBusiness(resource.data.businessId);
      allow write: if false;
    }

    match /notifications/{notificationId} {
      allow read: if ownsBusiness(resource.data.businessId);
      allow create, delete: if false;
      allow update: if ownsBusiness(resource.data.businessId) &&
        request.resource.data.businessId == resource.data.businessId &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['readAt']);
    }

    match /users/{userId} {
      allow read: if signedIn() && (request.auth.uid == userId || isInstitutionalAdmin());
      allow write: if false;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
